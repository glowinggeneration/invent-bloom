# Persona_Voices (FKF CommsIQ) — required environment variables.
# Copy to .env for local development. Never commit the real .env file
# (see Application Build Master Rules §3.3 — secrets stay out of source
# control, client bundles, logs and screenshots).
#
# Use separate values per environment (development / staging / production)
# and rotate any credential that is ever exposed rather than just removing
# it from the latest commit.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Service-role key: server-side only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI gateway ---
LOVABLE_API_KEY=
LOVABLE_SEND_URL=

# --- Data providers ---
APIFY_API_TOKEN=
NEWSDATA_API_KEY=
TWITTERAPI_IO_KEY=
GOOGLE_MAPS_API_KEY=
UNSPLASH_ACCESS_KEY=
DEFAULT_TWITTER_PROXY=
